<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 개발명세서(MVC): "NewsMapper XML id 일치" -->
<mapper namespace="com.example.mijang.news.mapper.NewsMapper">

    <select id="countBySymbol" resultType="long">
        SELECT COUNT(*)
          FROM news n
          JOIN news_stocks ns ON ns.news_id = n.news_id
         WHERE ns.symbol = #{symbol}
    </select>

</mapper>
