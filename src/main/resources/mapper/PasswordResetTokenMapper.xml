<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mijang.user.mapper.PasswordResetTokenMapper">

    <!-- record 라 setter 가 없다. arg 순서가 선언 순서와 정확히 같아야 한다 -->
    <resultMap id="tokenMap" type="com.example.mijang.user.domain.PasswordResetToken">
        <constructor>
            <idArg column="token_id"   javaType="java.lang.Long"/>
            <arg   column="user_id"    javaType="java.lang.Long"/>
            <arg   column="token_hash" javaType="java.lang.String"/>
            <arg   column="expires_at" javaType="java.time.LocalDateTime"/>
            <arg   column="used_at"    javaType="java.time.LocalDateTime"/>
            <arg   column="created_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <sql id="cols">token_id, user_id, token_hash, expires_at, used_at, created_at</sql>

    <!-- 링크 진입·저장 시 검증. 사용 여부와 만료는 서비스가 판단한다 -->
    <select id="findByTokenHash" parameterType="string" resultMap="tokenMap">
        SELECT <include refid="cols"/>
          FROM password_reset_tokens
         WHERE token_hash = #{tokenHash}
    </select>

    <!-- 재전송 쿨다운 판단용. 아직 살아 있는 것 중 가장 최근 하나 -->
    <select id="findLatestActiveByUserId" parameterType="long" resultMap="tokenMap">
        SELECT <include refid="cols"/>
          FROM password_reset_tokens
         WHERE user_id = #{userId}
           AND used_at IS NULL
           AND expires_at &gt; CURRENT_TIMESTAMP(3)
         ORDER BY token_id DESC
         LIMIT 1
    </select>

    <insert id="insert">
        INSERT INTO password_reset_tokens (user_id, token_hash, expires_at)
        VALUES (#{userId}, #{tokenHash}, #{expiresAt})
    </insert>

    <!-- used_at IS NULL 조건이 동시 사용을 막는다. 늦게 온 쪽은 0 행이 바뀐다 -->
    <update id="markUsed" parameterType="long">
        UPDATE password_reset_tokens
           SET used_at = CURRENT_TIMESTAMP(3)
         WHERE token_id = #{tokenId}
           AND used_at IS NULL
    </update>

    <!-- 새로 발급하기 전에 이전 링크를 죽인다 -->
    <update id="invalidateActiveByUserId" parameterType="long">
        UPDATE password_reset_tokens
           SET used_at = CURRENT_TIMESTAMP(3)
         WHERE user_id = #{userId}
           AND used_at IS NULL
    </update>

    <!-- 만료되고 하루 지난 것만 지운다. 방금 만료된 것은 남겨 두어야
         "만료된 링크입니다"를 정확히 안내할 수 있다 -->
    <delete id="deleteExpired">
        DELETE FROM password_reset_tokens
         WHERE expires_at &lt; DATE_SUB(CURRENT_TIMESTAMP(3), INTERVAL 1 DAY)
    </delete>

</mapper>
