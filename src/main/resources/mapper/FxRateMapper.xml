<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 개발명세서(MVC): "FxRateMapper XML id 일치" -->
<mapper namespace="com.example.mijang.fx.mapper.FxRateMapper">

    <select id="findRateByDate" resultType="java.math.BigDecimal">
        SELECT usd_krw
          FROM fx_rates
         WHERE base_date = #{baseDate}
    </select>

</mapper>
