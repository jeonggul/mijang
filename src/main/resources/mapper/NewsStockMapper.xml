<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 개발명세서(MVC): "NewsStockMapper XML id 일치" -->
<mapper namespace="com.example.mijang.news.mapper.NewsStockMapper">


    <!-- vendor_id 로 바로 잇는다. id 를 따로 물어보는 왕복을 없앤다 —
         기사마다 조회가 붙으면 한 번 수집에 수백 번이 나간다 -->
    <insert id="linkByVendorId">
        INSERT IGNORE INTO news_stocks (news_id, symbol)
        SELECT id, #{symbol} FROM news WHERE vendor_id = #{vendorId}
    </insert>

</mapper>
