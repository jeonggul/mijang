<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 개발명세서(MVC): "NewsStockMapper XML id 일치" -->
<mapper namespace="com.example.mijang.news.mapper.NewsStockMapper">

    <insert id="link">
        INSERT IGNORE INTO news_stocks (news_id, symbol)
        VALUES (#{newsId}, #{symbol})
    </insert>

</mapper>
