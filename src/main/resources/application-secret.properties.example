# 비밀정보 템플릿 — 이 파일을 복사해 application-secret.properties 를 만들고 실제 값을 채우세요.
#   cp application-secret.properties.example application-secret.properties
# application-secret.properties 는 .gitignore 로 커밋되지 않습니다.
# application.properties 에 아래 한 줄이 이미 들어 있어 자동으로 읽힙니다:
#   spring.profiles.include=secret

# ===== DB =====
spring.datasource.password=YOUR_DB_PASSWORD

# ===== 인증 =====
# JWT 서명 키. 아래 명령으로 만들어 붙여넣으세요.
#   openssl rand -base64 48
# 최소 32자 이상이어야 하며, 짧으면 앱이 기동되지 않습니다.
mijang.jwt.secret=YOUR_JWT_SECRET_AT_LEAST_32_CHARS

# ===== 외부 API 키 =====
# 값이 비어 있으면 해당 벤더 호출만 막히고, 앱은 정상 기동합니다.
# 채운 뒤 scripts/check-api-keys.sh 로 실제 응답을 확인하세요.

# Alpaca — https://app.alpaca.markets 대시보드 API Keys > Generate New Keys
# secret 은 생성 직후 화면에서 한 번만 보입니다. 놓치면 Regenerate 뿐입니다.
mijang.external.alpaca.api-key=YOUR_ALPACA_KEY_ID
mijang.external.alpaca.api-secret=YOUR_ALPACA_SECRET_KEY

# Finnhub — https://finnhub.io 가입 시 자동 발급되는 토큰 하나
mijang.external.finnhub.api-key=YOUR_FINNHUB_TOKEN

# 한국수출입은행 — 환율. 인증키 신청 후 승인까지 영업일이 걸립니다.
mijang.external.koreaexim.api-key=YOUR_EXIM_KEY

# SEC EDGAR — 키가 없습니다. 대신 연락 가능한 실제 이메일이 든 User-Agent 가 필수입니다.
# 형식: "앱이름 이메일". 위조하거나 비우면 403 이고, 반복하면 IP 가 차단됩니다.
mijang.external.sec.user-agent=mijang-dev your-email@example.com

# ===== 메일 (mijang.mail.transport=smtp 일 때만 필요) =====
# Gmail 은 계정 비밀번호가 아니라 앱 비밀번호(16자)를 쓴다.
# 계정 설정 → 보안 → 2단계 인증 → 앱 비밀번호에서 만든다.
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=
spring.mail.password=
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# 로그인 화면에 안내할 체험 계정. 비워 두면 안내 아이콘이 뜨지 않는다.
# 실제로 만든 계정이어야 한다 — 이 값으로 로그인이 되어야 안내가 의미가 있다.
mijang.demo-account.email=
mijang.demo-account.password=
