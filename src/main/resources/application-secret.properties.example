# 비밀정보 템플릿 — 이 파일을 복사해 application-secret.properties 를 만들고 실제 값을 채우세요.
#   cp application-secret.properties.example application-secret.properties
# application-secret.properties 는 .gitignore 로 커밋되지 않습니다.
# application.properties 에 아래 한 줄이 이미 들어 있어 자동으로 읽힙니다:
#   spring.profiles.include=secret

# ===== DB =====
spring.datasource.password=YOUR_DB_PASSWORD

# ===== 인증 =====
# JWT 서명 키. 아래 명령으로 만들어 붙여넣으세요.
#   openssl rand -base64 48
# 최소 32자 이상이어야 하며, 짧으면 앱이 기동되지 않습니다.
mijang.jwt.secret=YOUR_JWT_SECRET_AT_LEAST_32_CHARS

# ===== 외부 API 키 =====
# 값이 비어 있으면 해당 벤더 호출만 막히고, 앱은 정상 기동합니다.
# 채운 뒤 scripts/check-api-keys.sh 로 실제 응답을 확인하세요.

# Alpaca — https://app.alpaca.markets 대시보드 API Keys > Generate New Keys
# secret 은 생성 직후 화면에서 한 번만 보입니다. 놓치면 Regenerate 뿐입니다.
mijang.external.alpaca.api-key=YOUR_ALPACA_KEY_ID
mijang.external.alpaca.api-secret=YOUR_ALPACA_SECRET_KEY

# Finnhub — https://finnhub.io 가입 시 자동 발급되는 토큰 하나
mijang.external.finnhub.api-key=YOUR_FINNHUB_TOKEN

# 한국수출입은행 — 환율. 인증키 신청 후 승인까지 영업일이 걸립니다.
mijang.external.koreaexim.api-key=YOUR_EXIM_KEY

# SEC EDGAR — 키가 없습니다. 대신 연락 가능한 실제 이메일이 든 User-Agent 가 필수입니다.
# 형식: "앱이름 이메일". 위조하거나 비우면 403 이고, 반복하면 IP 가 차단됩니다.
mijang.external.sec.user-agent=mijang-dev your-email@example.com

# ===== 메일 (mijang.mail.transport=smtp 일 때만 필요) =====
#
# 아래 두 줄(username·password)을 채우고 application.properties 의
# mijang.mail.transport 를 log 에서 smtp 로 바꾸면 재설정 메일이 실제로 나간다.
# 비어 있으면 JavaMailSender 가 인증에 실패해 발송이 조용히 실패한다.
#
# Gmail 은 계정 비밀번호가 아니라 앱 비밀번호(16자)를 쓴다.
#   Google 계정 → 보안 → 2단계 인증(먼저 켜야 한다) → 앱 비밀번호
#   앱 이름을 아무거나 적으면 "abcd efgh ijkl mnop" 형태로 나온다.
#   공백은 빼고 16자를 그대로 붙여 넣는다.
#
# username 은 보내는 주소다. mijang.mail.from 과 다르면 Gmail 이 from 을 무시하고
# 이 주소로 바꿔 보낸다 — 받는 쪽에 다른 주소가 찍히므로 맞춰 두는 편이 낫다.
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=
spring.mail.password=
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# 로그인 화면 말풍선에 안내할 계정. 비워 두면 안내 아이콘이 뜨지 않는다.
# 실제로 만든 계정이어야 한다 — 이 값으로 로그인이 되어야 안내가 의미가 있다.
#
# 여기 적은 값은 비로그인 공개 화면(/login)의 소스에 그대로 실린다. hidden 은
# 화면에서 가릴 뿐이라, 적는 순간 공개된 계정이 된다. 그래서
#   - 관리자 계정을 적지 않는다. 적으면 운영 콘솔이 통째로 열린다.
#     (LoginHintService 가 걸러 내지만, 걸러지면 안내가 아예 안 뜬다)
#   - 본인 계정을 적지 않는다. 둘러보기 전용 계정을 따로 만들어 쓴다.
#
# password 는 비워 둘 수 있다. 비우면 이메일만 채우고 비밀번호는 직접 친다 —
# 남이 알면 안 되는 계정은 이렇게 둔다.
# 계정을 더 두려면 accounts[1], accounts[2] … 로 이어 붙인다.
# 한글은 쓰지 않는다 — properties 는 ISO-8859-1 로 읽혀 깨진다.
mijang.demo-account.accounts[0].email=
mijang.demo-account.accounts[0].password=

# ===== 소셜 로그인 =====
# 구글: console.cloud.google.com → 인증 플랫폼 → 클라이언트 → 웹 애플리케이션
# 카카오: developers.kakao.com → 앱 → 플랫폼 키(REST API 키) · 클라이언트 시크릿
# 리디렉션 URI 는 두 곳 모두 /login/oauth2/code/{google|kakao} 로 등록한다.
spring.security.oauth2.client.registration.google.client-id=
spring.security.oauth2.client.registration.google.client-secret=
spring.security.oauth2.client.registration.kakao.client-id=
spring.security.oauth2.client.registration.kakao.client-secret=
