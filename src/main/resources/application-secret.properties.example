# 비밀정보 템플릿 — 이 파일을 복사해 application-secret.properties 를 만들고 실제 값을 채우세요.
#   cp application-secret.properties.example application-secret.properties
# application-secret.properties 는 .gitignore 로 커밋되지 않습니다.
# 실제 값을 채운 뒤 application.properties 에 아래 한 줄을 추가하세요:
#   spring.profiles.include=secret

# ===== DB =====
spring.datasource.password=YOUR_DB_PASSWORD

# ===== 외부 API 키 =====
alpaca.api-key=YOUR_ALPACA_KEY
alpaca.api-secret=YOUR_ALPACA_SECRET
finnhub.api-key=YOUR_FINNHUB_KEY
koreaexim.api-key=YOUR_EXIM_KEY
